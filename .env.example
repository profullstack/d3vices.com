# d3vices.com — every value here is optional except SITE_URL in production.
# Secrets live on the Railway service and in the logicsrc vault, never in a committed .env.

# Every generated URL (canonical, og:image, sitemap, share links) is built from this.
SITE_URL=http://localhost:8080
PORT=8080

# Optional. Without it the site runs fully — share links are the only feature that needs it.
# DATABASE_URL=postgres://user:pass@host:5432/d3vices

# Optional privacy-preserving analytics endpoint. Unset = no third-party script at all.
# ANALYTICS_SRC=
# ANALYTICS_SITE_ID=

# Crawl gateway (@profullstack/x402-gateway): training crawlers pay $1/day over x402.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
